# PostgreSQL 운영 연결 예시. 비워 두면 backend/startin.db SQLite 로컬 개발 DB 사용.
DATABASE_URL=postgresql+psycopg://startin:CHANGE_ME@localhost:5433/startin
POSTGRES_PASSWORD=CHANGE_ME
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false
# HTTPS 배포에서는 COOKIE_SECURE=true 필수
# 예제 공고는 명시적으로 seed 명령으로만 추가합니다.
# 키가 없거나 호출이 실패하면 일반 키워드 검색을 사용합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
