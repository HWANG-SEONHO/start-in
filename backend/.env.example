# 학습용 설명: FastAPI 서버가 DB, 브라우저 접근, 쿠키, AI 기능에 사용할 환경변수 예시입니다.
# CHANGE_ME 같은 값은 예시이므로 실제 배포에서는 안전한 값으로 바꿔야 합니다.

# PostgreSQL 운영 연결 예시. 이 값을 쓰지 않으면 backend/startin.db SQLite 로컬 DB를 사용할 수 있습니다.
DATABASE_URL=postgresql+psycopg://startin:CHANGE_ME@localhost:5433/startin
POSTGRES_PASSWORD=CHANGE_ME

# 이 주소에서 열린 브라우저만 FastAPI에 접근하도록 허용합니다.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 로컬 HTTP 개발에서는 false, 실제 HTTPS 배포에서는 true가 필요합니다.
COOKIE_SECURE=false

# 키가 없거나 호출이 실패하면 일반 키워드 검색을 사용합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
